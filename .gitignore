# build output
/nori
*.test

# runtime state (created by running nori)
/data
/backups
*.log

# frontend deps and build output (built by CI, releases and Docker;
# .gitkeep keeps the directory so go:embed compiles without a UI build)
ui/node_modules/
ui/dist/*
!ui/dist/.gitkeep

# zcode session tooling
.zcode/

# goreleaser output
/dist/

# fly.io config: generate per-app from fly.toml.example
/fly.toml
.zcodeignore

# local stress-test rig (xlsx, containers, load-test artifacts)
/stress-run/
